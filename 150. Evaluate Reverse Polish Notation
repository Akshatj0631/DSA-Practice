class Solution {
    public int evalRPN(String[] tokens) {
  

        Stack<Integer> st = new Stack<>();

        for (String str : tokens) {

            if (!str.equals("+") &&

                !str.equals("-") &&

                !str.equals("*") &&

                !str.equals("/")) {

                st.push(Integer.parseInt(str));

            } else {

                int a = st.pop();

                int b = st.pop();

                if (str.equals("+"))

                    st.push(b + a);

                else if (str.equals("-"))

                    st.push(b - a);

                else if (str.equals("*"))

                    st.push(b * a);

                else

                    st.push(b / a);

            }

        }

        return st.pop();
    }
}
